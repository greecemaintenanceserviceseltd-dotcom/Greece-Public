{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "types": ["node", "@netlify/functions"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["db/**/*.ts", "netlify/functions/**/*.mts", "drizzle.config.ts"]
}
